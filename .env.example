# Names only. Never put real values in this file or in chat.
# Real values go in EAS: expo.dev -> project -> Environment variables
# (or `eas env:create`). EXPO_PUBLIC_* values end up inside the app,
# so only public keys may use that prefix.

# RevenueCat public iOS SDK key (Milestone 2). Public by design.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# App Group shared with the widget (Milestone 4). Not secret.
APPLE_APP_GROUP_ID=
