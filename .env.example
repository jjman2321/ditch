# Names only. Never put real values in this file or in chat.
# Real values go in EAS: expo.dev -> project -> Environment variables
# (or `eas env:create`). EXPO_PUBLIC_* values end up inside the app,
# so only public keys may use that prefix.

# RevenueCat public iOS SDK key ("appl_..."). Public by design (it ships inside the app).
# Without it, purchases stay off ("Not switched on yet"). docs/plans/revenuecat-setup.md
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# App Group shared with the widget (Milestone 4). Not secret.
APPLE_APP_GROUP_ID=

# Bank sync server: https://<project-ref>.supabase.co/functions/v1 (DECISIONS #67).
# Not secret. Leave empty to use sample bank data (Expo Go, web preview).
EXPO_PUBLIC_API_URL=
