{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_APP_ENV": "development", "EXPO_PUBLIC_DEV_TOOLS": "1" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_APP_ENV": "preview", "EXPO_PUBLIC_DEV_TOOLS": "1" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_ENV": "production", "EXPO_PUBLIC_DEV_TOOLS": "0" }
    }
  },
  "submit": {
    "production": {}
  }
}
