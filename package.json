    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run lint && npm run typecheck && npm test",
    "prices": "node scripts/build-prices.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "fx": "node scripts/build-fx.mjs",
    "rights": "node scripts/build-rights.mjs",
    "preview:build": "EXPO_PUBLIC_APP_ENV=web-preview EXPO_PUBLIC_DEV_TOOLS=1 expo export -p web --output-dir dist-web",
    "preview:deploy": "npm run preview:build && cd preview-site && ../web/node_modules/.bin/wrangler deploy"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/design/",
      "/web/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/web/"
    ]
  }
