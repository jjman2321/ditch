# Edge Function secrets: NAMES ONLY. Never put real values here or in chat.
# Real values: Supabase -> Project settings -> Edge Functions -> Secrets
# (or `supabase secrets set NAME=value` from your own terminal).
# For `supabase functions serve` locally, copy to supabase/functions/.env (git-ignored).

# Plaid (dashboard.plaid.com -> Developers -> Keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=
# https://<project-ref>.supabase.co/functions/v1/plaid-webhook
PLAID_WEBHOOK_URL=
# https Universal Link for OAuth banks, e.g. https://ditchsubs.app/plaid/oauth (also in Plaid Dashboard)
PLAID_REDIRECT_URI=
# Optional, default US,CA
PLAID_COUNTRY_CODES=

# Which provider new connections use: plaid (default) | stripe
BANK_PROVIDER=
# Stripe Financial Connections fallback only (dashboard.stripe.com -> Developers -> API keys)
STRIPE_SECRET_KEY=

# 32 random bytes, base64. Encrypts bank access tokens at rest. Make with: openssl rand -base64 32
# Losing it means every bank must be reconnected; changing it needs a re-encrypt step.
TOKEN_ENC_KEY=

# Apple
APPLE_BUNDLE_ID=
# Optional, default Production,Sandbox (Sandbox = TestFlight and App Review)
APPLE_ENVIRONMENTS=
# App Store Connect product ids (comma-separated if more than one per kind)
APPLE_PRODUCT_YEARLY=
APPLE_PRODUCT_WEEKLY=
APPLE_PRODUCT_LIFETIME=
APPLE_PRODUCT_BANK_ADDON=

# Shared with pg_cron (Vault secret "cron_secret"). Make with: openssl rand -hex 32
CRON_SECRET=

# Set by Supabase automatically, don't add: SUPABASE_URL, SUPABASE_SECRET_KEYS / SUPABASE_SERVICE_ROLE_KEY
