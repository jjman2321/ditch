{
  "name": "ditchsubs-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-data.mjs",
    "predev": "npm run sync",
    "dev": "next dev",
    "prebuild": "npm run sync",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "npm run sync && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run sync && opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "^4.158.0"
  }
}
